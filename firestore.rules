rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // New Google accounts create their own users/{uid} doc as "pending" on first sign-in;
    // only someone editing it directly in the Firestore console can flip it to "approved"
    // (see allow update below — the app itself never gets write access to that field).
    function isApproved() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.status == 'pending';
      allow update, delete: if false;
    }

    match /years/{yearId} {
      allow read, write: if isApproved();
    }

    match /subjects/{subjectId} {
      allow read, write: if isApproved();
    }

    match /folders/{folderId} {
      allow read, write: if isApproved();
    }

    match /notes/{noteId} {
      allow read, write: if isApproved();
    }

    // Shared by the whole group, same as notes: any approved account can add an event and
    // any of them can mark it done. scheduleVersion is written by the app on reschedule and
    // read back by the reminder tasks, so it is deliberately not locked down further —
    // there is nothing here worth protecting from an already-approved member.
    match /calendarEvents/{eventId} {
      allow read, write: if isApproved();
    }

    // One doc per browser/device, keyed by its FCM token. Nobody can read the collection
    // from the app — only the announceNote function, which runs with admin credentials and
    // bypasses these rules — so one person's tokens are never exposed to another's client.
    match /fcmTokens/{token} {
      allow read, list: if false;
      allow create, update: if isApproved() && request.resource.data.uid == request.auth.uid;
      allow delete: if isApproved() && resource.data.uid == request.auth.uid;
    }
  }
}
