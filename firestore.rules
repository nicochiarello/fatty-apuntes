rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /years/{yearId} {
      allow read, write: if signedIn();
    }

    match /subjects/{subjectId} {
      allow read, write: if signedIn();
    }

    match /notes/{noteId} {
      allow read, write: if signedIn();
    }
  }
}
